# Copy to .env (gitignored). Not auto-loaded — pass it explicitly:
#   node --env-file=.env server.js
# On Render these go in the dashboard, not in a file.

# Storage. Omit STORE to use the local JSON file at data/store.json.
# DATABASE_URL must be Supabase's session pooler (5432), not the
# transaction pooler (6543) — migrations use multi-statement DDL.
STORE=pg
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PGSSL=require
PG_STORE_KEY=state
PG_POOL_MAX=5
# RNREADY_STORE=/tmp/store.json   # overrides the JSON store path (tests)

# Auth. ADMIN_KEY is break-glass admin; it falls back to "dev-admin"
# locally, and NODE_ENV=production refuses to boot without a real one.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# AUTH_KEYS roles: author | reviewer | publisher | editor
ADMIN_KEY=
AUTH_KEYS=KEY1:author:Kim,KEY2:reviewer:Sam,KEY3:publisher:Lee

# Server. PORT is set by Render. Leave NODE_ENV unset for local dev.
PORT=3000
# NODE_ENV=production
# REQ_LOG=1                       # log every request: method, path, status, ms

# Demo / practice question set (DEPLOYMENT.md §4c).
# Seed it first:  DATABASE_URL="…" npm run db:seed:demo
# DEMO_BANK=1  → the server serves ONLY the 128-question demo set (107 items + 6 cases).
# unset/false → the regular bank; demo rows in the database are ignored.
# DEMO_BANK=1

# Local HTTPS, opt-in — both must be set.
# TLS_CERT=data/tls/dev.crt
# TLS_KEY=data/tls/dev.key
# TLS_PORT=3443
