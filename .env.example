# RN Ready — environment reference. Copy to .env for local use.
# Production values live in the Render dashboard, never in the repo.
# Full table: DEPLOYMENT.md §6.

# ── Server ────────────────────────────────────────────────────────────
PORT=3000                 # Render sets this automatically
# NODE_ENV=production     # with this set, the server REFUSES to boot
                          # unless ADMIN_KEY is also set (see server.js:15)

# ── Storage ───────────────────────────────────────────────────────────
# Omit STORE entirely to use the local JSON file (data/store.json).
# STORE=pg
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# PGSSL=require           # required by Supabase/Render/RDS; auto-detected
# PG_STORE_KEY=state      # legacy-blob row key; leave as-is
# PG_POOL_MAX=5

# ── Auth ──────────────────────────────────────────────────────────────
# Break-glass admin key (all actions). Render generates this for you.
# Defaults to "dev-admin" locally — NEVER ship that value.
ADMIN_KEY=dev-admin
# Staff authoring keys: "key:role:name,key:role:name"
# roles: author | reviewer | publisher | editor
# AUTH_KEYS=s3cret-A:author:Kim,better-B:reviewer:Sam

# ── Optional local HTTPS (opt-in; both must be set) ───────────────────
# TLS_CERT=data/tls/dev.crt
# TLS_KEY=data/tls/dev.key
# TLS_PORT=3443
